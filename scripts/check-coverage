#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

if ! cargo llvm-cov --version >/dev/null 2>&1; then
  echo "coverage blocker: cargo-llvm-cov is not installed" >&2
  echo "withheld: exact_source_coverage and full_fitted_governance" >&2
  exit 2
fi

cargo llvm-cov clean --workspace
profile_root="$repo_root/target/llvm-cov-target"
mkdir -p "$profile_root"
export LLVM_PROFILE_FILE="$profile_root/research-run-%m-%p.profraw"
exec cargo llvm-cov --locked --test product \
  --ignore-filename-regex '(_tests(/|\.rs$)|tests/)' \
  --fail-under-lines 100 \
  --fail-under-functions 100 \
  --fail-under-regions 100
