#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
export CARGO_PROFILE_TEST_DEBUG="${CARGO_PROFILE_TEST_DEBUG:-0}"
if [[ "${RESEARCH_RUN_MUTATION_JOBS-1}" != "1" ]]; then
  echo "mutation custody failure: RESEARCH_RUN_MUTATION_JOBS must be 1" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 2
fi
mutation_jobs=1
candidate="$(git rev-parse HEAD)"
if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  echo "mutation failure: the candidate worktree must be clean before the frozen-candidate gate" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
fi

selection='parse_artifact|validate_id|validate_timestamp|read_json_bytes|reject_symlink_chain|WorkspaceWriteLock::acquire|Workspace::publish_bytes|inspect_publication|link_canonical|Workspace::load_mutable_snapshot|Workspace::preflight_recovery|canonical_manifest|canonical_records|validate_recovered_authority|commit_recovery|terminal_text|source_requires_review|claim_assessment|review_authority_status|InventoryPlan::validate|MigrationPlan::validate|KnowledgeRecord::validate|RelationshipRecord::validate|ReviewAuthorization::validate|ReviewRequest::validate|anchor_review_authority|ReviewAuthority::from_openssh|Workspace::initialize_with_review_authority|initialize_for_inventory|verify_initialized_authority|Workspace::prepare_review_request|Workspace::authorize_review_request|Workspace::verify_review_authorization|authority_matches_manifest|request_from_review|parse_authority_key|parse_openssh_public_key|verify_signature|verify|decode_armor|fingerprint|scan_materials|enforce_file_count|add_inventory_bytes|reconcile|review_subject_sha256|review_binding_errors|hash_evidence_authority|current_review_bindings|Workspace::add_knowledge|Workspace::add_relationship|Workspace::plan_retrofit|plan_inventory|verified_inventory_plan_snapshot|inventory_plan_review_authority|Workspace::apply_inventory_plan|Workspace::apply_inventory_plan_locked|inventory_apply_workspace|inspect_inventory_bootstrap_scaffold|clear_exact_pending_bootstrap|clear_linked_bootstrap_pending|finish_inventory_bootstrap|inventory_bootstrap_error|ensure_inventory_bootstrap_marker|initialize_inventory_bootstrap|inventory_bootstrap_marker|verify_inventory_target|latest_inventory_from_snapshot|Workspace::apply_migration|Workspace::context|Workspace::search|HandoffBundle::validate'
RUSTFLAGS='--cfg coverage --check-cfg=cfg(coverage)' cargo mutants \
  --cap-lints true \
  --test-tool cargo \
  --cargo-arg=-j \
  --cargo-arg=1 \
  --jobs "$mutation_jobs" \
  --jobserver false \
  --timeout 60 \
  --build-timeout 60 \
  --baseline run \
  --re "$selection"

inventory="mutants.out/mutants.json"
required_boundaries=(
  "src/workspace/sshsig.rs:verify"
  "src/workspace/sshsig.rs:decode_armor"
  "src/workspace/sshsig.rs:fingerprint"
  "src/workspace/review_authority.rs:authority_matches_manifest"
  "src/workspace/review_authority.rs:request_from_review"
  "src/workspace/inventory_authority.rs:verify_inventory_target"
)
for boundary in "${required_boundaries[@]}"; do
  file="${boundary%%:*}"
  function="${boundary#*:}"
  jq -e --arg file "$file" --arg function "$function" \
    'any(.[]; .file == $file and .function.function_name == $function)' \
    "$inventory" >/dev/null || {
      echo "mutation failure: required boundary absent from candidate inventory: $boundary" >&2
      echo "withheld: mutation_proof and package_delta_closure" >&2
      exit 1
    }
done
selected="$(jq 'length' "$inventory")"
if (( selected < 223 )); then
  echo "mutation failure: candidate inventory unexpectedly shrank below the 223-mutant reviewed baseline" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
fi

outcomes="mutants.out/outcomes.json"
validate_outcomes() {
  local outcomes_path="$1"
  jq -e --slurpfile inventory "$inventory" '
    ($inventory[0] | map(.name) | sort) as $expected_names |
    ([.outcomes[] | select(.scenario == "Baseline")]) as $baselines |
    ([.outcomes[] | select(
      (.scenario | type) == "object" and (.scenario | has("Mutant"))
    )]) as $mutant_outcomes |
    ($mutant_outcomes | map(.scenario.Mutant.name) | sort) as $actual_names |
    ($baselines | length) == 1 and
    $baselines[0].summary == "Success" and
    (.outcomes | length) == (($expected_names | length) + 1) and
    $actual_names == $expected_names and
    ($actual_names | unique | length) == ($actual_names | length) and
    all($mutant_outcomes[];
    .summary == "CaughtMutant" or
    .summary == "Unviable") and
    ([$mutant_outcomes[] | select(.summary == "CaughtMutant")] | length > 0)
  ' "$outcomes_path" >/dev/null
}

validate_outcomes "$outcomes" || {
  echo "mutation failure: selected boundary set contains a missed, timed-out, or otherwise unresolved mutant" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
}

tampered_outcomes="$(mktemp "${TMPDIR:-/tmp}/research-run-mutation-outcomes.XXXXXX")"
trap 'rm -f "$tampered_outcomes"' EXIT
for transform in \
  'del(.outcomes[1])' \
  '.outcomes += [.outcomes[1]]' \
  '.outcomes[1].scenario.Mutant.name = "unexpected-mutant"' \
  '.outcomes[1].summary = "Success"' \
  '.outcomes[1].summary = "MissedMutant"' \
  '.outcomes[1].summary = "Timeout"' \
  '.outcomes[1].summary = "UnknownOutcome"'; do
  jq "$transform" "$outcomes" > "$tampered_outcomes"
  if validate_outcomes "$tampered_outcomes"; then
    echo "mutation fixture failure: incomplete, duplicate, unexpected, or baseline-only outcomes were accepted" >&2
    echo "withheld: mutation_proof and package_delta_closure" >&2
    exit 1
  fi
done

caught="$(jq '[.outcomes[] | select(.summary == "CaughtMutant")] | length' "$outcomes")"
unbuildable="$(jq '[.outcomes[] | select(.summary == "Unviable")] | length' "$outcomes")"
if [[ "$(git rev-parse HEAD)" != "$candidate" ]] \
  || [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
  echo "mutation failure: candidate identity or worktree changed during the gate" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
fi
inventory_sha256="$(shasum -a 256 "$inventory" | awk '{print $1}')"
echo "bounded mutation proof: candidate $candidate; inventory $inventory_sha256; $selected selected; $caught viable mutants killed; $unbuildable mutants classified unbuildable by compiler output in mutants.out/log"
