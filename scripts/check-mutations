#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
export CARGO_PROFILE_TEST_DEBUG="${CARGO_PROFILE_TEST_DEBUG:-0}"
mutation_jobs="${RESEARCH_RUN_MUTATION_JOBS:-1}"

selection='parse_artifact|validate_id|validate_timestamp|read_json_bytes|reject_symlink_chain|WorkspaceWriteLock::acquire|Workspace::publish_bytes|inspect_publication|link_canonical|Workspace::preflight_recovery|canonical_manifest|canonical_records|validate_recovered_authority|commit_recovery|terminal_text|source_requires_review|claim_assessment|InventoryPlan::validate|MigrationPlan::validate|KnowledgeRecord::validate|RelationshipRecord::validate|ReviewAuthorization::validate|ReviewRequest::validate|anchor_review_authority|ReviewAuthority::from_openssh|Workspace::initialize_with_review_authority|Workspace::prepare_review_request|Workspace::authorize_review_request|Workspace::verify_review_authorization|parse_authority_key|parse_openssh_public_key|verify_signature|scan_materials|enforce_file_count|add_inventory_bytes|reconcile|review_subject_sha256|review_binding_errors|hash_evidence_authority|current_review_bindings|Workspace::add_knowledge|Workspace::add_relationship|Workspace::apply_inventory_plan|Workspace::apply_migration|Workspace::context|Workspace::search|HandoffBundle::validate'
RUSTFLAGS='--cfg coverage --check-cfg=cfg(coverage)' cargo mutants \
  --cap-lints true \
  --test-tool cargo \
  --cargo-arg=-j \
  --cargo-arg=1 \
  --jobs "$mutation_jobs" \
  --jobserver false \
  --timeout 60 \
  --build-timeout 60 \
  --baseline run \
  --re "$selection"

outcomes="mutants.out/outcomes.json"
jq -e '
  all(.outcomes[];
    .summary == "Success" or
    .summary == "CaughtMutant" or
    .summary == "Unviable") and
  ([.outcomes[] | select(.summary == "CaughtMutant")] | length > 0)
' "$outcomes" >/dev/null || {
  echo "mutation failure: selected boundary set contains a missed, timed-out, or otherwise unresolved mutant" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
}

caught="$(jq '[.outcomes[] | select(.summary == "CaughtMutant")] | length' "$outcomes")"
unbuildable="$(jq '[.outcomes[] | select(.summary == "Unviable")] | length' "$outcomes")"
echo "bounded mutation proof: $caught viable mutants killed; $unbuildable mutants classified unbuildable by compiler output in mutants.out/log"
