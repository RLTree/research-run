#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

selection='parse_artifact|validate_id|validate_timestamp|read_json_bytes|reject_symlink_chain|WorkspaceWriteLock::acquire|Workspace::publish_bytes|inspect_publication|link_canonical|Workspace::preflight_recovery|commit_recovery|terminal_text|source_requires_review|claim_assessment|InventoryPlan::validate|MigrationPlan::validate|KnowledgeRecord::validate|RelationshipRecord::validate|scan_materials|enforce_file_count|add_inventory_bytes|reconcile|review_subject_sha256|review_binding_errors|hash_evidence_authority|current_review_bindings|Workspace::add_knowledge|Workspace::add_relationship|Workspace::apply_inventory_plan|Workspace::apply_migration|Workspace::context|Workspace::search|HandoffBundle::validate'
# Capacity is independently proven at its exact 10,000-record boundary. It does
# not exercise this selected semantic set and would consume each mutant timeout.
mutation_tests='not test(/capacity/)'

RUSTFLAGS='--cfg coverage --check-cfg=cfg(coverage)' cargo mutants \
  --cap-lints true \
  --test-tool nextest \
  --jobs 4 \
  --timeout 60 \
  --build-timeout 60 \
  --baseline run \
  --re "$selection" \
  -- -E "$mutation_tests"

outcomes="mutants.out/outcomes.json"
jq -e '
  all(.outcomes[];
    .summary == "Success" or
    .summary == "CaughtMutant" or
    .summary == "Unviable") and
  ([.outcomes[] | select(.summary == "CaughtMutant")] | length > 0)
' "$outcomes" >/dev/null || {
  echo "mutation failure: selected boundary set contains a missed, timed-out, or otherwise unresolved mutant" >&2
  echo "withheld: mutation_proof and package_delta_closure" >&2
  exit 1
}

caught="$(jq '[.outcomes[] | select(.summary == "CaughtMutant")] | length' "$outcomes")"
unbuildable="$(jq '[.outcomes[] | select(.summary == "Unviable")] | length' "$outcomes")"
echo "bounded mutation proof: $caught viable mutants killed; $unbuildable mutants classified unbuildable by compiler output in mutants.out/log"
