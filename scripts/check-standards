#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

ledger="agent-standards/obligations.json"
expected="agent-standards/expected-classifications.json"

validate_classifications() {
  jq -e --slurpfile expected "$expected" '
    ([.package_delta.clusters[] | {key: .id, value: .status}] | from_entries)
      == $expected[0].cluster_status and
    ([.obligations[] | {key: .id, value: .status}] | from_entries)
      == $expected[0].obligation_status and
    ([.obligations[] | {key: .id, value: .evidence}] | from_entries)
      == $expected[0].obligation_evidence
  ' "$1" >/dev/null
}

jq -e '
  .schema_version == 1 and
  (.source.commit == "69787f20adcf0b99c7f3a26f71b35a215fda28d6") and
  (.package_delta.artifact == "harness-ultragoal-governance-complete.zip") and
  (.package_delta.sha256 == "089382f27b64c6eb219b3a032296917dc8984129a52e56e63cb77ba66ba72377") and
  (.package_delta.inventory == {"laws":160,"classified_items":172,"validator_issues":0}) and
  (.namespace.boundary_exceptions | length == 2) and
  (.namespace.boundary_exceptions | any(
    .path == "src/lib.rs" and .class == "product_source" and
    .allowed_name == "lib" and (.forcing_contract | startswith("Cargo library crate root")))) and
  (.namespace.boundary_exceptions | any(
    .path == "fixtures/namespace/red/phase4_rebind.rs" and
    .class == "validator_fixture" and .allowed_name == "phase4_rebind" and
    (.forcing_contract | startswith("HU-CORE-012")))) and
  ([.package_delta.clusters[].law_count] | add == 160) and
  (.package_delta.clusters | any(
    .id == "typed-authority-proof-and-agent-legibility" and
    (.evidence | index("scripts/check-standards")) and
    (.evidence | index("scripts/check-coverage")) and
    (.evidence | index("scripts/check-product-artifacts")))) and
  (.package_delta.clusters | any(
    .id == "rust-correctness-security-performance" and
    (.evidence | index("scripts/check-dependencies")) and
    (.evidence | index("scripts/check-mutations")) and
    (.evidence | index("scripts/check-product-artifacts")))) and
  (.package_delta.clusters | any(
    .id == "minimal-local-gold-stack" and
    (.evidence | index("scripts/check-dependencies")) and
    (.evidence | index("scripts/check-product-artifacts")))) and
  all(.package_delta.clusters[];
    (.status == "mechanized" and
      (.evidence | type == "array") and (.evidence | length > 0) and
      all(.evidence[]; type == "string" and length > 0) and
      any(.evidence[]; test("^(scripts/|tests/|src/|Cargo\\.toml|rust-toolchain\\.toml|schemas/)"))) or
    (.status == "not_applicable" and (.evidence | type == "array") and
      all(.evidence[]; type == "string" and length > 0) and (.reason | length > 40))) and
  ([.package_delta.clusters[] | {key: .id, value: .status}] | from_entries) == {
    "typed-authority-proof-and-agent-legibility":"mechanized",
    "rust-correctness-security-performance":"mechanized",
    "minimal-local-gold-stack":"mechanized",
    "distribution-receipt-control-plane":"not_applicable",
    "rust-untriggered-specialists-and-release":"not_applicable",
    "gold-stack-untriggered-services-and-release":"not_applicable",
    "typescript-ui-overlay":"not_applicable"
  } and
  ([.package_delta.clusters[].status] | index("in_progress") | not) and
  (.obligations | length == 12) and
  ([.obligations[].module] | unique | length == 12) and
  all(.obligations[];
    (.status == "mechanized" and (.evidence | type == "array") and
      (.evidence | length > 0) and all(.evidence[]; type == "string" and length > 0)) or
    (.status == "not_applicable" and (.evidence | type == "array") and
      all(.evidence[]; type == "string" and length > 0) and (.reason | length > 20))) and
  ([.obligations[] | {key: .id, value: .status}] | from_entries) == {
    "namespace-progressive-disclosure":"mechanized",
    "boundaries-validation-enforcement":"mechanized",
    "execplans-worktrees-orchestration":"mechanized",
    "security-reliability-product-cohesion":"mechanized",
    "review-completion":"mechanized",
    "standards-gardening":"mechanized",
    "cli-authority-proof-surfaces":"mechanized",
    "observability-repair-loop":"not_applicable",
    "product-success-quality-in-use":"mechanized",
    "plugin-activation-distribution":"not_applicable",
    "research-improvement-quality-gates":"mechanized",
    "tool-risk-runtime-substrates":"mechanized"
  }
' "$ledger" >/dev/null || {
  echo "standards obligation failure: every UltraGoal 0.0.12 module must be uniquely classified, with executable evidence or a concrete repository-specific non-applicability reason" >&2
  echo "withheld: agent_standard_closure and material_completion" >&2
  exit 1
}
validate_classifications "$ledger" || {
  echo "standards obligation failure: an obligation status or evidence binding differs from the reviewed classification contract" >&2
  echo "withheld: agent_standard_closure and material_completion" >&2
  exit 1
}

jq -e '
  .schema_version == 1 and
  .kind == "product-fitness-disposition" and
  .claim_id == "research-run-v0.1-real-use-fitness" and
  .status == "withheld" and
  .owner == "human product-fitness reviewer" and
  .candidate_binding.status == "declared-pending-receipt" and
  .candidate_binding.current_candidate == "git:HEAD" and
  (.candidate_binding.resolver | contains("clean worktree")) and
  (.candidate_binding.required_identity | contains("clean Git HEAD")) and
  (.candidate_binding.required_identity | contains("platform-qualified normalized")) and
  .candidate_binding.installed_binary.platform == "aarch64-apple-darwin" and
  .candidate_binding.installed_binary.raw_bytes == 2271376 and
  .candidate_binding.installed_binary.signature_profile == {
    verification:"codesign --verify --strict",
    format:"Mach-O thin (arm64)",
    signature:"adhoc",
    code_directory_flags:"0x20002(adhoc,linker-signed)",
    hash_type:"sha256",
    team_identifier:"not set",
    info_plist:"not bound",
    sealed_resources:"none",
    internal_requirements:"none",
    executable_segment_flags:"0x1",
    authorities:[],
    entitlements:"empty"
  } and
  .candidate_binding.installed_binary.signature_profile_sha256 == "a21345461360d035ba5e371bd1d91c5ea98f60cfd8850a2bc157e3d4f01219bd" and
  .candidate_binding.installed_binary.normalization == "removed ad-hoc code signature and zeroed Mach-O LC_UUID" and
  .candidate_binding.installed_binary.normalized_sha256 == "ab5745af96a9aa588f8a4db34223c59d8db5431c3f4b38d5b66144a45398be7c" and
  .candidate_binding.installed_binary.normalized_bytes == 2253600 and
  (.candidate_binding.installed_binary.receipt | startswith("scripts/check-product-artifacts")) and
  (.candidate_binding.reason | contains("is not evidence until")) and
  .audience == [
    "researcher",
    "repository owner and review-key signer",
    "agent operating the CLI"
  ] and
  (.job | contains("Initialize or retrofit")) and
  (.context | contains("installed Rust CLI")) and
  (.desired_outcome | contains("review-governed research state")) and
  .accessibility_evidence.status == "missing" and
  .cognitive_load_evidence.status == "missing" and
  .recovery_burden.status == "unmeasured" and
  .continuance_evidence.status == "missing" and
  .real_use_evidence == {
    "status": "none",
    "synthetic_journeys_are_non_substitutes": true
  } and
  (.dispositions | map(.claim_id) == [
    "research-run-v0.1-complete-unfamiliar-project-workflow",
    "research-run-v0.1-real-use-fitness"
  ]) and
  all(.dispositions[]; .status == "withheld" and (.reason | length > 40)) and
  (.reason | length > 40) and
  (.affected_claims | type == "array" and length == 4) and
  (.required_follow_up | contains("actor-disjoint Product Fitness review")) and
  (.accepted_non_substitutes == [
    "source tests", "coverage or mutation proof", "installed journey",
    "synthetic signing", "package proof", "benchmark", "generic reviewer approval"
  ]) and
  (.claim_ceiling | contains("real-use fitness, continuance, and research impact remain withheld"))
' agent-standards/product-fitness-disposition.json >/dev/null || {
  echo "product fitness failure: real-use claims require a complete typed withholding disposition or fresh audience-bound proof" >&2
  echo "withheld: product_fitness, continuance, research_impact, and material_completion" >&2
  exit 1
}

tampered_ledger="$(mktemp "${TMPDIR:-/tmp}/research-run-standards.XXXXXX")"
trap 'rm -f "$tampered_ledger"' EXIT
for red_transform in fixtures/standards/red/*.jq; do
  jq -f "$red_transform" "$ledger" > "$tampered_ledger"
  if validate_classifications "$tampered_ledger"; then
    echo "standards fixture failure: $red_transform bypassed exact classification validation" >&2
    echo "withheld: agent_standard_closure and material_completion" >&2
    exit 1
  fi
done

shopt -s nullglob
active_plans=(docs/exec-plans/active/*.md)
if [[ "${#active_plans[@]}" -ne 1 || "${active_plans[0]}" != "docs/exec-plans/active/2026-07-18-complete-agent-operated-research-run.md" ]]; then
  echo "standards obligation failure: exactly one named current ExecPlan must exist" >&2
  echo "withheld: execution_authority and material_completion" >&2
  exit 1
fi

for gate in scripts/check scripts/check-coverage scripts/check-standards \
  scripts/check-dependencies scripts/check-mutations scripts/check-product-artifacts; do
  if [[ ! -x "$gate" ]]; then
    echo "standards obligation failure: claimed executable evidence $gate is missing or not executable" >&2
    echo "withheld: agent_standard_closure and package_delta_closure" >&2
    exit 1
  fi
done

evidence_paths="$(jq -er '[.obligations[], .package_delta.clusters[]]
  | map(select(.status == "mechanized"))
  | map(.evidence[]) | unique | .[]' "$ledger")"
while IFS= read -r evidence; do
  case "$evidence" in
    /*|..|../*|*/..|*/../*)
      echo "standards obligation failure: mechanized evidence path $evidence escapes the repository" >&2
      echo "withheld: agent_standard_closure and package_delta_closure" >&2
      exit 1
      ;;
  esac
  if [[ ! -e "$evidence" ]]; then
    echo "standards obligation failure: mechanized evidence path $evidence is missing" >&2
    echo "withheld: agent_standard_closure and package_delta_closure" >&2
    exit 1
  fi
  evidence_entry="$repo_root"
  IFS='/' read -r -a evidence_segments <<< "$evidence"
  for segment in "${evidence_segments[@]}"; do
    evidence_entry="$evidence_entry/$segment"
    if [[ -L "$evidence_entry" ]]; then
      echo "standards obligation failure: mechanized evidence path $evidence contains a symlink" >&2
      echo "withheld: agent_standard_closure and package_delta_closure" >&2
      exit 1
    fi
  done
  resolved_evidence="$(realpath "$evidence")"
  if [[ "$resolved_evidence" != "$repo_root" && "$resolved_evidence" != "$repo_root/"* ]]; then
    echo "standards obligation failure: mechanized evidence path $evidence resolves outside the repository" >&2
    echo "withheld: agent_standard_closure and package_delta_closure" >&2
    exit 1
  fi
done <<< "$evidence_paths"

if rg -n '/Users/|/home/[^/]+/|Downloads/' AGENTS.md STANDARD.md policy.toml \
  agent-standards docs README.md >/dev/null; then
  echo "authority portability failure: tracked authority contains a host-specific absolute path" >&2
  echo "withheld: source_governance and package_delta_closure" >&2
  exit 1
fi

banned='(^|[_-])(goal|gate[0-9]*|phase[0-9]*|slice|lane|workstream|checkpoint|backlog|progress|todo|wip|production_proof|claim_closure|readiness_packet|finalization_work|helpers|utils|common|misc|shared|support|services|lib|core|internal(_[a-z0-9_-]+)?|fit_command|fit_path|fit_goal|fit_slice)([_-]|$)'

check_name() {
  local kind="$1" value="$2" location="$3"
  if printf '%s\n' "$value" | rg -i -q "$banned"; then
    echo "namespace violation: $location has $kind '$value'; it describes goal/process/proof work rather than product behavior. Rename it for the owned Research Run behavior, or add a typed boundary exception naming the forcing external contract. withheld: namespace_law and material_completion" >&2
    return 1
  fi
}

classify_path() {
  case "$1" in
    src/*) echo product_source ;;
    tests/*) echo product_test ;;
    agent-standards/*|docs/*|AGENTS.md|AGENT_STANDARDS.md|ARCHITECTURE.md|STANDARD.md|policy.toml) echo governance ;;
    scripts/*|.github/*) echo check_authority ;;
    schemas/*|examples/*) echo data_contract ;;
    Cargo.toml|Cargo.lock|rust-toolchain.toml|deny.toml) echo cargo_substrate ;;
    .gitignore|LICENSE|README.md) echo repository_metadata ;;
    fixtures/*) echo validator_fixture ;;
    target|target/*|mutants.out*|mutants.out*/*|*.crate) echo generated_ephemeral ;;
    *) return 1 ;;
  esac
}

while IFS= read -r path; do
  class="$(classify_path "$path")" || {
    echo "namespace classification failure: $path has no governed path class. Add one exact class and rerun scripts/check-standards. withheld: namespace_law and material_completion" >&2
    exit 1
  }
  jq -e --arg class "$class" '.namespace.path_classes | any(.id == $class)' "$ledger" >/dev/null || {
    echo "namespace classification failure: $path resolved to undeclared class $class" >&2
    exit 1
  }
  if jq -e --arg path "$path" '.namespace.boundary_exceptions | any(.path == $path)' "$ledger" >/dev/null; then
    jq -e --arg path "$path" --arg class "$class" '.namespace.boundary_exceptions | any(
      .path == $path and .class == $class and
      (.allowed_name | length > 0) and (.forcing_contract | length > 20))' "$ledger" >/dev/null || {
      echo "namespace exception failure: $path lacks an exact class, allowed name, and forcing contract" >&2
      exit 1
    }
    continue
  fi
  case "$path" in
    fixtures/namespace/tamper/exception.json) ;;
  esac
  IFS='/' read -r -a segments <<< "$path"
  for segment in "${segments[@]}"; do
    semantic_segment="${segment%%.*}"
    check_name "path segment" "$semantic_segment" "$path"
  done
done < <(git ls-files --cached --others --exclude-standard)

while IFS= read -r path; do
  path="${path%/}"
  class="$(classify_path "$path")" || {
    echo "namespace classification failure: ignored generated path $path has no governed path class" >&2
    exit 1
  }
  if [[ "$class" != "generated_ephemeral" ]]; then
    echo "namespace classification failure: ignored path $path is not classified as generated ephemeral output" >&2
    exit 1
  fi
done < <(git status --ignored --short | awk '$1 == "!!" { print $2 }')

check_name "green fixture symbol" "publish_review_decision" "fixtures/namespace/green/review_decision.rs"
if check_name "red fixture symbol" "phase4_rebind" "fixtures/namespace/red/phase4_rebind.rs" >/dev/null 2>&1; then
  echo "namespace fixture failure: red phase name was accepted" >&2
  exit 1
fi
if check_name "tamper fixture symbol" "fit_slice" "fixtures/namespace/tamper/exception.json" >/dev/null 2>&1; then
  echo "namespace fixture failure: a goal-vocabulary exception bypassed validation" >&2
  exit 1
fi

cargo test --locked --test standards_syntax --quiet

echo "standards classifications: 12 source modules and 160 package laws validated; product-fitness withholding, paths, namespace, and semantic-tree fixtures passed"
