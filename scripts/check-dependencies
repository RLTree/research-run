#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

duplicates="$(cargo tree --locked --duplicates 2>/dev/null)"
if [[ -n "$duplicates" ]]; then
  echo "dependency duplication failure:" >&2
  printf '%s\n' "$duplicates" >&2
  echo "withheld: dependency_closure and package_delta_closure" >&2
  exit 1
fi

cargo audit --deny warnings
cargo deny check

inventory_root="$(mktemp -d "${TMPDIR:-/tmp}/research-run-inventory.XXXXXX")"
generated_inventory="$repo_root/research-run-inventory.json"
trap 'rm -f "$generated_inventory"; rm -rf "$inventory_root"' EXIT
cargo cyclonedx --manifest-path "$repo_root/Cargo.toml" --format json \
  --override-filename research-run-inventory
inventory="$inventory_root/research-run-inventory.json"
mv "$generated_inventory" "$inventory"
jq -e '.bomFormat == "CycloneDX" and .metadata.component.name == "research-run"' "$inventory" >/dev/null
echo "dependency proof: no duplicate versions; audit and deny passed; ephemeral CycloneDX inventory validated"
