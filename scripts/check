#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
export CARGO_PROFILE_TEST_DEBUG="${CARGO_PROFILE_TEST_DEBUG:-0}"

mode="${1:-fast}"

run_supported_artifact_gate() {
  local actual_platform expected_platform
  actual_platform="$(rustc -vV | sed -n 's/^host: //p')"
  expected_platform="$(
    jq -er '.candidate_binding.installed_binary.platform' \
      agent-standards/product-fitness-disposition.json
  )"
  if [[ "$actual_platform" == "$expected_platform" ]]; then
    scripts/check-product-artifacts
    return
  fi
  echo "artifact proof skipped: host $actual_platform does not match declared platform $expected_platform"
  echo "withheld: package, install, journey, performance_baseline, and compactness_baseline"
}

case "$mode" in
  fast)
    cargo fmt --check
    cargo check --locked --all-targets
    cargo test --locked --test product repository_authority::
    scripts/check-standards
    ;;
  full)
    cargo fmt --check
    cargo check --locked --all-targets
    cargo nextest run --locked --all-targets --test-threads 1
    cargo test --locked --doc
    cargo clippy --locked --all-targets -- -D warnings
    scripts/check-standards
    scripts/check-coverage
    scripts/check-dependencies
    gitleaks git --no-banner --redact .
    actionlint
    scripts/check-mutations
    run_supported_artifact_gate
    ;;
  coverage)
    exec "$repo_root/scripts/check-coverage"
    ;;
  dependencies)
    exec "$repo_root/scripts/check-dependencies"
    ;;
  mutations)
    exec "$repo_root/scripts/check-mutations"
    ;;
  artifacts)
    exec "$repo_root/scripts/check-product-artifacts"
    ;;
  *)
    echo "usage: scripts/check {fast|full|coverage|dependencies|mutations|artifacts}" >&2
    exit 2
    ;;
esac
