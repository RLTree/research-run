#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

artifact_platform="$(rustc -vV | sed -n 's/^host: //p')"

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

file_mode() {
  if [[ "$artifact_platform" == *-apple-darwin ]]; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

workspace_fingerprint() {
  printf '. directory %s -\n' "$(file_mode "$1")"
  workspace_fingerprint_walk "$1" "$1"
}

workspace_fingerprint_walk() {
  local state="$1" directory="$2" path relative type payload mode
  local LC_ALL=C
  local entries=()
  shopt -s dotglob nullglob
  entries=("$directory"/*)
  shopt -u dotglob nullglob
  for path in "${entries[@]}"; do
    relative="${path#"$state"/}"
    mode="$(file_mode "$path")"
    if [[ -L "$path" ]]; then
      type="symlink"
      payload="$(readlink "$path")"
    elif [[ -f "$path" ]]; then
      type="file"
      payload="$(sha256_file "$path")"
    elif [[ -d "$path" ]]; then
      type="directory"
      payload="-"
    elif [[ -p "$path" ]]; then
      type="fifo"
      payload="-"
    elif [[ -S "$path" ]]; then
      type="socket"
      payload="-"
    elif [[ -b "$path" ]]; then
      type="block-device"
      payload="-"
    elif [[ -c "$path" ]]; then
      type="character-device"
      payload="-"
    else
      type="other"
      payload="-"
    fi
    printf '%q %s %s %q\n' "$relative" "$type" "$mode" "$payload"
    if [[ "$type" == "directory" ]]; then
      workspace_fingerprint_walk "$state" "$path"
    fi
  done
}

workspace_fingerprint_self_test() (
  set -euo pipefail
  local fixture state baseline changed
  fixture="$(mktemp -d "${TMPDIR:-/tmp}/research-run-fingerprint.XXXXXX")"
  trap 'rm -rf "$fixture"' EXIT
  state="$fixture/state"
  mkdir "$state"
  chmod 700 "$state"
  printf 'record\n' >"$state/record"
  chmod 600 "$state/record"
  baseline="$(workspace_fingerprint "$state")"

  chmod 750 "$state"
  changed="$(workspace_fingerprint "$state")"
  [[ "$baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a root-directory mode change" >&2
    return 1
  }
  chmod 700 "$state"

  chmod 640 "$state/record"
  changed="$(workspace_fingerprint "$state")"
  [[ "$baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a mode change" >&2
    return 1
  }
  chmod 600 "$state/record"

  mkdir "$state/empty"
  chmod 700 "$state/empty"
  changed="$(workspace_fingerprint "$state")"
  [[ "$baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed an empty directory" >&2
    return 1
  }
  local directory_baseline="$changed"
  chmod 750 "$state/empty"
  changed="$(workspace_fingerprint "$state")"
  [[ "$directory_baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a directory mode change" >&2
    return 1
  }
  rmdir "$state/empty"

  ln -s record "$state/link"
  changed="$(workspace_fingerprint "$state")"
  [[ "$baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a symlink" >&2
    return 1
  }
  local link_baseline="$changed"
  ln -snf missing "$state/link"
  changed="$(workspace_fingerprint "$state")"
  [[ "$link_baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a symlink retarget" >&2
    return 1
  }
  rm "$state/link"

  mv "$state/record" "$state/retained"
  ln -s retained "$state/record"
  changed="$(workspace_fingerprint "$state")"
  [[ "$baseline" != "$changed" ]] || {
    echo "workspace fingerprint missed a file-to-symlink replacement" >&2
    return 1
  }
)

if [[ "${1:-}" == "--fingerprint-self-test" ]]; then
  workspace_fingerprint_self_test
  exit 0
fi
if (( $# != 0 )); then
  echo "usage: scripts/check-product-artifacts [--fingerprint-self-test]" >&2
  exit 2
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "artifact proof requires a clean commit candidate" >&2
  echo "withheld: package, install, journey, performance_baseline, and compactness_baseline" >&2
  exit 1
fi

observation_root="$(mktemp -d "${TMPDIR:-/tmp}/research-run-artifacts.XXXXXX")"
trap 'rm -rf "$observation_root"' EXIT
workspace_fingerprint_self_test

target_before_kib="$(du -sk target 2>/dev/null | awk '{print $1}' || printf '0')"
cargo build --locked --release
cargo package --locked

archive="$repo_root/target/package/research-run-0.1.0.crate"
tar -xzf "$archive" -C "$observation_root"
cargo install --path "$observation_root/research-run-0.1.0" --locked \
  --root "$observation_root/install"
binary="$observation_root/install/bin/research-run"
signature_profile='null'
signature_profile_sha256=''
if [[ "$artifact_platform" == *-apple-darwin ]]; then
  codesign --verify --strict "$binary"
  signature_metadata="$(codesign -d --verbose=4 "$binary" 2>&1)"
  if ! grep -Eq '^CodeDirectory v=20400 size=[0-9]+ flags=0x20002\(adhoc,linker-signed\) hashes=[0-9]+\+0 location=embedded$' \
    <<<"$signature_metadata"; then
    echo "artifact proof rejected unexpected CodeDirectory metadata" >&2
    exit 1
  fi
  for expected in \
    "Format=Mach-O thin (arm64)" \
    "Hash type=sha256 size=32" \
    "Executable Segment flags=0x1" \
    "Signature=adhoc" \
    "Info.plist=not bound" \
    "TeamIdentifier=not set" \
    "Sealed Resources=none" \
    "Internal requirements=none"; do
    grep -Fxq "$expected" <<<"$signature_metadata"
  done
  if grep -q '^Authority=' <<<"$signature_metadata"; then
    echo "artifact proof rejected a certificate-backed authority" >&2
    exit 1
  fi
  entitlements="$(codesign -d --entitlements - "$binary" 2>/dev/null)"
  if [[ -n "$entitlements" ]]; then
    echo "artifact proof rejected non-empty entitlements" >&2
    exit 1
  fi
  signature_profile="$(jq -cn '{
    verification:"codesign --verify --strict",
    format:"Mach-O thin (arm64)",
    signature:"adhoc",
    code_directory_flags:"0x20002(adhoc,linker-signed)",
    hash_type:"sha256",
    team_identifier:"not set",
    info_plist:"not bound",
    sealed_resources:"none",
    internal_requirements:"none",
    executable_segment_flags:"0x1",
    authorities:[],
    entitlements:"empty"
  }')"
  signature_profile_sha256="$(printf '%s' "$signature_profile" | shasum -a 256 | awk '{print $1}')"
fi
if command -v sha256sum >/dev/null 2>&1; then
  binary_raw_sha256="$(sha256sum "$binary" | awk '{print $1}')"
else
  binary_raw_sha256="$(shasum -a 256 "$binary" | awk '{print $1}')"
fi
binary_bytes="$(wc -c < "$binary" | tr -d ' ')"
normalized_binary="$observation_root/research-run-normalized"
cp "$binary" "$normalized_binary"
if [[ "$artifact_platform" == *-apple-darwin ]]; then
  codesign --remove-signature "$normalized_binary"
  uuid_offset="$(otool -l "$normalized_binary" | awk '
    BEGIN { offset = 32 }
    /^[[:space:]]*cmd / {
      if ($2 == "LC_UUID") {
        print offset + 8
        exit
      }
    }
    /^[[:space:]]*cmdsize / { offset += $2 }
  ')"
  if [[ -z "$uuid_offset" ]]; then
    echo "artifact proof could not locate the Mach-O LC_UUID command" >&2
    exit 1
  fi
  dd if=/dev/zero of="$normalized_binary" bs=1 seek="$uuid_offset" \
    count=16 conv=notrunc 2>/dev/null
  normalization="removed ad-hoc code signature and zeroed Mach-O LC_UUID"
else
  normalization="raw executable bytes"
fi
if command -v sha256sum >/dev/null 2>&1; then
  normalized_sha256="$(sha256sum "$normalized_binary" | awk '{print $1}')"
else
  normalized_sha256="$(shasum -a 256 "$normalized_binary" | awk '{print $1}')"
fi
normalized_bytes="$(wc -c < "$normalized_binary" | tr -d ' ')"
jq -e \
  --arg platform "$artifact_platform" \
  --arg normalization "$normalization" \
  --arg normalized_sha256 "$normalized_sha256" \
  --arg signature_profile_sha256 "$signature_profile_sha256" \
  --argjson signature_profile "$signature_profile" \
  --argjson bytes "$binary_bytes" \
  --argjson normalized_bytes "$normalized_bytes" '
    .candidate_binding.status == "tracked-declaration-not-evidence" and
    .candidate_binding.current_candidate == "resolved by the external receipt validator" and
    (.candidate_binding.resolver | contains("never a receipt")) and
    .candidate_binding.installed_binary.platform == $platform and
    .candidate_binding.installed_binary.raw_bytes == $bytes and
    .candidate_binding.installed_binary.signature_profile == $signature_profile and
    .candidate_binding.installed_binary.signature_profile_sha256 == $signature_profile_sha256 and
    .candidate_binding.installed_binary.normalization == $normalization and
    .candidate_binding.installed_binary.normalized_sha256 == $normalized_sha256 and
    .candidate_binding.installed_binary.normalized_bytes == $normalized_bytes
  ' agent-standards/product-fitness-disposition.json >/dev/null

workspace="$observation_root/journey"
ssh-keygen -q -t ed25519 -N '' -f "$observation_root/review-key"
"$binary" init "$workspace" --name "Installed researcher journey" \
  --review-authority-id researcher \
  --review-authority-public-key "$observation_root/review-key.pub" >/dev/null

installed_command() {
  (cd "$workspace" && "$binary" "$@")
}

printf '%s' '# Existing project law

Preserve these installed-package journey bytes exactly.
' >"$workspace/AGENTS.md"
cp "$workspace/AGENTS.md" "$observation_root/existing-agents.md"
chmod 0640 "$workspace/AGENTS.md"
existing_instruction_sha256="$(sha256_file "$workspace/AGENTS.md")"
existing_instruction_bytes="$(wc -c < "$workspace/AGENTS.md" | tr -d ' ')"
existing_instruction_mode="$(file_mode "$workspace/AGENTS.md")"
[[ "$existing_instruction_mode" == "640" ]]
"$binary" agent-integration status "$workspace" --json | jq -e \
  '.protocol_installed == true and .instruction_contract_installed == false and .agent_integration_ready == false' \
  >/dev/null

"$binary" agent-integration plan "$workspace" >"$observation_root/agent-plan.json"
jq -e \
  --arg instruction_sha256 "$existing_instruction_sha256" \
  --argjson instruction_bytes "$existing_instruction_bytes" '
    .operation == "append" and
    .instruction_path == "AGENTS.md" and
    .instruction_sha256 == $instruction_sha256 and
    .instruction_bytes == $instruction_bytes
  ' "$observation_root/agent-plan.json" >/dev/null
"$binary" agent-integration apply "$workspace" \
  --input "$observation_root/agent-plan.json" --json | jq -e \
  '.changed == true and .ready_for_new_agent_run == true and .current_session_loaded == "unverified"' \
  >/dev/null
dd if="$workspace/AGENTS.md" bs=1 count="$existing_instruction_bytes" 2>/dev/null | \
  cmp - "$observation_root/existing-agents.md"
[[ "$(file_mode "$workspace/AGENTS.md")" == "$existing_instruction_mode" ]]
[[ "$(wc -c < "$workspace/AGENTS.md" | tr -d ' ')" -gt "$existing_instruction_bytes" ]]
grep -Fq '<!-- research-run:agent-integration:v1:start -->' "$workspace/AGENTS.md"
"$binary" agent-integration apply "$workspace" \
  --input "$observation_root/agent-plan.json" --json | jq -e '.changed == false' >/dev/null
"$binary" agent-integration status "$workspace" --json | jq -e \
  '.agent_integration_ready == true and .ready_scope == "new-agent-run" and .fresh_session_required == true' \
  >/dev/null
workspace_fingerprint "$workspace/.research-run" >"$observation_root/state-before-context"
installed_command context --query buffer >"$observation_root/context.json"
workspace_fingerprint "$workspace/.research-run" >"$observation_root/state-after-context"
cmp "$observation_root/state-before-context" "$observation_root/state-after-context"
jq -e \
  '.matches == [] and .contribution_protocol.sequence == ["retrieve-bounded-context", "classify-new-material", "append-typed-records", "validate-workspace", "answer-or-handoff"]' \
  "$observation_root/context.json" \
  >/dev/null
jq -n '{schema_version:1,kind:"knowledge",id:"decision-buffer",record_type:"decision",title:"Use the selected buffer",body:"The researcher selected the recorded buffer condition.",occurred_at:"2026-08-20T18:00:00Z",state:"active",authorship:"human"}' \
  >"$observation_root/decision.json"
jq -n '{schema_version:1,kind:"knowledge",id:"next-buffer-check",record_type:"next-action",title:"Check the buffer condition",body:"Verify the selected buffer condition in the next bounded run.",occurred_at:"2026-08-20T18:01:00Z",state:"open",authorship:"human"}' \
  >"$observation_root/next.json"
jq -n '{schema_version:1,kind:"relationship",id:"relationship-buffer-next",relationship:"depends-on",from:{kind:"knowledge",id:"next-buffer-check"},to:{kind:"knowledge",id:"decision-buffer"},rationale:"The next action implements the human decision.",occurred_at:"2026-08-20T18:02:00Z",authorship:"human"}' \
  >"$observation_root/relationship.json"
installed_command knowledge add --input "$observation_root/decision.json" >/dev/null
installed_command knowledge add --input "$observation_root/next.json" >/dev/null
installed_command relationship add --input "$observation_root/relationship.json" >/dev/null

installed_command source add --id source-one --citation Citation --locator local:source \
  --provenance human >/dev/null
installed_command claim add --id claim-one --text Claim --scope Scope --owner Researcher \
  --authorship human >/dev/null
installed_command evidence add --id evidence-one --claim claim-one --source source-one \
  --stance supports --specific-evidence Specific --authorship human >/dev/null
installed_command experiment add --id experiment-one --question 'Question?' --method-ref method.md \
  --observation Observed --interpretation Interpretation --limitation Limited \
  --outcome negative --next-move Repeat >/dev/null
installed_command review prepare --id review-one --claim claim-one --decision limited \
  --rationale 'Negative repeat limits the claim.' --reviewer Researcher \
  >"$observation_root/review-request.json"
ssh-keygen -Y sign -f "$observation_root/review-key" \
  -n research-run-review-v1 "$observation_root/review-request.json" >/dev/null
installed_command review add --request "$observation_root/review-request.json" \
  --signature "$observation_root/review-request.json.sig" >/dev/null
installed_command validate --json >"$observation_root/validation-receipt.json"
jq -e \
  '.schema_version == 2 and .valid == true and .authority.project_id == "installed-researcher-journey" and .agent_integration.agent_integration_ready == true' \
  "$observation_root/validation-receipt.json" \
  >/dev/null
validation_receipt_sha256="$(sha256_file "$observation_root/validation-receipt.json")"
installed_command handoff create --id handoff-installed-agent \
  --generated-at 2026-08-20T20:00:00Z --query buffer \
  >"$observation_root/handoff-receipt.json"
installed_command handoff inspect --input "$observation_root/handoff-receipt.json" \
  >"$observation_root/handoff-inspected.json"
jq -S . "$observation_root/handoff-receipt.json" >"$observation_root/handoff-created.sorted.json"
jq -S . "$observation_root/handoff-inspected.json" >"$observation_root/handoff-inspected.sorted.json"
cmp "$observation_root/handoff-created.sorted.json" "$observation_root/handoff-inspected.sorted.json"
jq -S . "$observation_root/validation-receipt.json" >"$observation_root/validation-result.sorted.json"
jq -S '.validation.result' "$observation_root/handoff-receipt.json" \
  >"$observation_root/handoff-validation-result.sorted.json"
cmp "$observation_root/validation-result.sorted.json" \
  "$observation_root/handoff-validation-result.sorted.json"
project_id="$(jq -er '.project_id' "$observation_root/agent-plan.json")"
workspace_id="$(jq -er '.workspace_id' "$observation_root/agent-plan.json")"
manifest_sha256="$(jq -er '.manifest_sha256' "$observation_root/agent-plan.json")"
protocol_sha256="$(jq -er '.protocol_sha256' "$observation_root/agent-plan.json")"
instruction_sha256="$(sha256_file "$workspace/AGENTS.md")"
printf '%s' "$(jq -c '.validation.result' "$observation_root/handoff-receipt.json")" \
  >"$observation_root/handoff-result.compact.json"
printf '%s' "$(jq -c '.context' "$observation_root/handoff-receipt.json")" \
  >"$observation_root/handoff-context.compact.json"
result_sha256="$(sha256_file "$observation_root/handoff-result.compact.json")"
context_sha256="$(sha256_file "$observation_root/handoff-context.compact.json")"
jq -e \
  --arg project_id "$project_id" \
  --arg workspace_id "$workspace_id" \
  --arg manifest_sha256 "$manifest_sha256" \
  --arg protocol_sha256 "$protocol_sha256" \
  --arg instruction_sha256 "$instruction_sha256" \
  --arg result_sha256 "$result_sha256" \
  --arg context_sha256 "$context_sha256" \
  '.schema_version == 2 and
   .validation.result.valid == true and
   .context.project_id == $project_id and
   .context.workspace_id == $workspace_id and
   .validation.result.authority.project_id == $project_id and
   .validation.result.authority.workspace_id == $workspace_id and
   .validation.result.authority.manifest_sha256 == $manifest_sha256 and
   .validation.result.authority.protocol_sha256 == $protocol_sha256 and
   .validation.result.authority.instruction_sha256 == $instruction_sha256 and
   .validation.result_sha256 == $result_sha256 and
   .validation.context_sha256 == $context_sha256 and
   (.context.matches | any(.id == "decision-buffer"))' \
  "$observation_root/handoff-receipt.json" \
  >/dev/null
handoff_receipt_sha256="$(sha256_file "$observation_root/handoff-receipt.json")"
installed_command status --json | jq -e \
  '.claims[0].assessment == "limited" and .experiments[0].outcome == "negative"' >/dev/null

measure_real() {
  local output_file="$1"
  shift
  local command_status measured
  set +e
  { time -p "$@" >/dev/null; } 2>"$output_file"
  command_status=$?
  set -e
  measured="$(awk '$1 == "real" { print $2; exit }' "$output_file")"
  if (( command_status != 0 )); then
    return "$command_status"
  fi
  [[ -n "$measured" ]]
  printf '%s\n' "$measured"
}

run_repeated() {
  local repetitions="$1"
  shift
  local iteration
  for ((iteration = 0; iteration < repetitions; iteration++)); do
    "$@" >/dev/null
  done
}

measure_average() {
  local output_file="$1" repetitions="$2"
  shift 2
  local total
  total="$(measure_real "$output_file" run_repeated "$repetitions" "$@")"
  awk -v total="$total" -v repetitions="$repetitions" \
    'BEGIN { printf "%.6f", total / repetitions }'
}

help_cold_seconds="$(measure_real "$observation_root/help-cold.time" "$binary" --help)"
help_warm_seconds="$(measure_average "$observation_root/help-warm.time" 50 "$binary" --help)"
status_cold_seconds="$(measure_real "$observation_root/status-cold.time" installed_command status --json)"
status_warm_seconds="$(measure_average "$observation_root/status-warm.time" 50 installed_command status --json)"

recovery_source="$workspace/.research-run/sources/source-one.json"
recovery_pending="$workspace/.research-run/sources/.source-one.json.9.1.tmp"
mv "$recovery_source" "$recovery_pending"
recovery_cold_seconds="$(measure_real "$observation_root/recovery-cold.time" "$binary" recover "$workspace" --json)"
recovery_warm_seconds="$(measure_average "$observation_root/recovery-warm.time" 50 "$binary" recover "$workspace" --json)"

stripped="$observation_root/research-run-stripped"
cp "$binary" "$stripped"
strip "$stripped"

archive_bytes="$(wc -c < "$archive" | tr -d ' ')"
stripped_binary_bytes="$(wc -c < "$stripped" | tr -d ' ')"
install_kib="$(du -sk "$observation_root/install" | awk '{print $1}')"
target_after_kib="$(du -sk target | awk '{print $1}')"
coverage_target_kib="$(du -sk target/llvm-cov-target 2>/dev/null | awk '{print $1}' || printf '0')"

jq -n \
  --arg candidate "$(git rev-parse HEAD)" \
  --arg cache_state "warm Cargo cache; clean source candidate" \
  --arg installed_binary_platform "$artifact_platform" \
  --arg installed_binary_raw_sha256 "$binary_raw_sha256" \
  --arg installed_binary_signature_profile_sha256 "$signature_profile_sha256" \
  --argjson installed_binary_signature_profile "$signature_profile" \
  --arg installed_binary_normalization "$normalization" \
  --arg installed_binary_normalized_sha256 "$normalized_sha256" \
  --arg validation_receipt_sha256 "$validation_receipt_sha256" \
  --arg handoff_receipt_sha256 "$handoff_receipt_sha256" \
  --argjson archive_bytes "$archive_bytes" \
  --argjson binary_bytes "$binary_bytes" \
  --argjson normalized_binary_bytes "$normalized_bytes" \
  --argjson stripped_binary_bytes "$stripped_binary_bytes" \
  --argjson install_kib "$install_kib" \
  --argjson target_before_kib "$target_before_kib" \
  --argjson target_after_kib "$target_after_kib" \
  --argjson coverage_target_kib "$coverage_target_kib" \
  --argjson help_cold_seconds "$help_cold_seconds" \
  --argjson help_warm_seconds "$help_warm_seconds" \
  --argjson status_cold_seconds "$status_cold_seconds" \
  --argjson status_warm_seconds "$status_warm_seconds" \
  --argjson recovery_cold_seconds "$recovery_cold_seconds" \
  --argjson recovery_warm_seconds "$recovery_warm_seconds" \
  '{candidate:$candidate, cache_state:$cache_state, installed_binary_platform:$installed_binary_platform, installed_binary_raw_sha256:$installed_binary_raw_sha256, installed_binary_signature_profile:$installed_binary_signature_profile, installed_binary_signature_profile_sha256:$installed_binary_signature_profile_sha256, installed_binary_normalization:$installed_binary_normalization, installed_binary_normalized_sha256:$installed_binary_normalized_sha256, journey:{agent_integration_operation:"append",validation_receipt_sha256:$validation_receipt_sha256,handoff_receipt_sha256:$handoff_receipt_sha256,preserved_existing_instruction_bytes:true,preserved_unix_mode:true,ready_scope:"new-agent-run",current_session_loaded:"unverified"}, timer_resolution_seconds:0.01, latency_seconds:{first_use:{cold_single:$help_cold_seconds,warm_average_50:$help_warm_seconds},status:{cold_single:$status_cold_seconds,warm_average_50:$status_warm_seconds},recovery:{cold_single:$recovery_cold_seconds,warm_average_50:$recovery_warm_seconds}}, bytes:{package_archive:$archive_bytes,installed_binary:$binary_bytes,normalized_binary:$normalized_binary_bytes,stripped_binary:$stripped_binary_bytes}, kib:{install_footprint:$install_kib,target_before:$target_before_kib,target_after:$target_after_kib,coverage_target:$coverage_target_kib}, claim_ceiling:"single-machine, platform-qualified installed Append journey only; exact existing bytes and Unix mode are preserved, bounded retrieval is observed read-only before typed contribution, and validation plus v2 handoff receipts are retained; no universal agent compliance, actual session loading, crash durability, xattr or ACL preservation, scientific truth, cross-machine result, or regression promise"}'
