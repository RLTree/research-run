#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "release candidate check requires a clean exact commit" >&2
  exit 1
fi

version="$(awk -F'"' '/^version = / { print $2; exit }' Cargo.toml)"
[[ "$version" == "0.1.0" ]]
[[ -f LICENSE && -f CHANGELOG.md && -f SECURITY.md ]]
rg -q '^## 0\\.1\\.0 — Unreleased$' CHANGELOG.md
rg -q 'Validation proves ledger integrity, not scientific truth' CHANGELOG.md
rg -q 'configured-key control, not personhood' CHANGELOG.md
rg -q 'publication_authorized = false' policy.toml
rg -q 'personhood_claim = false' policy.toml
rg -q 'scientific_truth_claim = false' policy.toml
rg -q 'Product Fitness.*remain.*withheld|remain explicitly withheld' \
  docs/release/0.1.0.md
rg -q 'does not authorize a merge, tag, package publication, or GitHub' \
  docs/release/0.1.0.md
[[ -x scripts/check-product-fitness-receipt ]]
[[ -x scripts/prepare-release-authorization ]]
[[ -x scripts/verify-release-authorization ]]
[[ -z "$(find src -maxdepth 1 -type f -name '*.rs' \
  ! -name 'lib.rs' ! -name 'main.rs' -print)" ]]

jq -n \
  --arg candidate "$(git rev-parse HEAD)" \
  --arg tree "$(git rev-parse 'HEAD^{tree}')" \
  --arg version "$version" \
  --arg lockfile_sha256 "$(shasum -a 256 Cargo.lock | awk '{print $1}')" '{
    candidate: $candidate,
    tree: $tree,
    version: $version,
    cargo_lock_sha256: $lockfile_sha256,
    release_class: "technical-preview",
    publication_authorized: false,
    product_fitness: "withheld-unless-separately-disposed",
    personhood_claim: false,
    scientific_truth_claim: false
  }'
