#!/usr/bin/env bash

validate_release_authority_id() {
  local authority_id="$1"
  if [[ ! "$authority_id" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo "release authority ID must be a lowercase slug" >&2
    return 2
  fi
}

canonical_release_public_key() {
  local public_key="$1"
  if [[ ! -f "$public_key" || -L "$public_key" ]]; then
    echo "release authority public key must be a regular non-symlink file" >&2
    return 2
  fi

  local lines key_description public_key_line
  lines="$(wc -l <"$public_key" | tr -d ' ')"
  if [[ "$lines" != "1" ]]; then
    echo "release authority public key must contain exactly one line" >&2
    return 2
  fi
  IFS= read -r public_key_line <"$public_key"
  if [[ ! "$public_key_line" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,2}$ ]]; then
    echo "release authority public key must be one canonical comment-free Ed25519 key" >&2
    return 2
  fi

  key_description="$(ssh-keygen -lf "$public_key" -E sha256)"
  if [[ "$key_description" != *"(ED25519)"* ]]; then
    echo "release authority must be an Ed25519 public key" >&2
    return 2
  fi
  printf '%s\n' "$public_key_line"
}
