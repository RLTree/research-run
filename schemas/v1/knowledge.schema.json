{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-run.local/schemas/v1/knowledge.schema.json",
  "title": "Research Run Knowledge Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "record_type", "title", "body", "occurred_at", "state", "authorship"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "knowledge" },
    "id": { "$ref": "types.schema.json#/$defs/id" },
    "record_type": {
      "enum": ["goal", "research-question", "hypothesis", "protocol", "method", "observation", "measurement", "analysis", "interpretation", "decision", "risk", "blocker", "uncertainty", "contradiction", "next-action", "plan", "presentation", "session-summary"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "body": { "type": "string", "maxLength": 65536 },
    "occurred_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "state": { "enum": ["open", "active", "completed", "resolved"] },
    "authorship": { "$ref": "types.schema.json#/$defs/authorship" }
  }
}
