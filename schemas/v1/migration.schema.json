{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-run.local/schemas/v1/migration.schema.json",
  "title": "Research Run Lossless Migration Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "project_id", "from_format", "to_format", "migrated_at", "authority_files", "authority_bytes", "authority_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "migration" },
    "id": { "$ref": "types.schema.json#/$defs/id" },
    "project_id": { "$ref": "types.schema.json#/$defs/id" },
    "from_format": { "const": "research-run-v0.1" },
    "to_format": { "const": "research-run-v0.1-extended" },
    "migrated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "authority_files": { "type": "integer", "minimum": 1 },
    "authority_bytes": { "type": "integer", "minimum": 1 },
    "authority_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
