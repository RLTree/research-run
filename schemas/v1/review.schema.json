{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "Research Run ReviewDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "claim_id", "decision", "rationale", "reviewer"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "review" },
    "id": { "$ref": "types.schema.json#/$defs/id" },
    "claim_id": { "$ref": "types.schema.json#/$defs/id" },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "types.schema.json#/$defs/id" }
    },
    "decision": { "enum": ["unsupported", "limited", "supported", "contradicted"] },
    "rationale": { "$ref": "types.schema.json#/$defs/text" },
    "reviewer": { "$ref": "types.schema.json#/$defs/text" }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "supported" } } },
      "then": {
        "required": ["evidence_ids"],
        "properties": { "evidence_ids": { "minItems": 1 } }
      }
    }
  ]
}
