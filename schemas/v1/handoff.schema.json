{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-run.local/schemas/v1/handoff.schema.json",
  "title": "Research Run Handoff Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "generated_at", "context"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "handoff" },
    "id": { "$ref": "types.schema.json#/$defs/id" },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "context": {
      "type": "object",
      "required": ["kind", "project_id", "project_name", "claim_ceiling", "scope", "matches", "unresolved", "blockers", "next_actions", "relationships"],
      "properties": {
        "kind": { "const": "context" },
        "project_id": { "$ref": "types.schema.json#/$defs/id" },
        "project_name": { "type": "string", "minLength": 1 },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "matches": { "type": "array", "maxItems": 256 },
        "unresolved": { "type": "array", "maxItems": 256 },
        "blockers": { "type": "array", "maxItems": 256 },
        "next_actions": { "type": "array", "maxItems": 256 },
        "relationships": { "type": "array", "maxItems": 256 }
      }
    }
  }
}
